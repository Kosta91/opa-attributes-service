# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opa_attributes
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DEBUG_SQL=false

# === Redis ===
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# === Azure Entra ID ===
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=
ENTRA_SCOPES=["https://graph.microsoft.com/.default"]
